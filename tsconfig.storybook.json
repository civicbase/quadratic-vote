{
  // Storybook is type-checked separately from the library so that the release
  // path (`tsconfig.json` -> `npm run type-check` -> `prepublishOnly`) never
  // depends on documentation code.
  //
  // It used to also switch moduleResolution, because the library was on the
  // classic "Node" strategy which cannot read the `exports` maps Storybook's
  // packages ship. TypeScript 7 removed that strategy, so the base config is
  // "Bundler" and this inherits it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["stories", ".storybook"],
  "references": []
}
